# gaokao-analyzer 环境变量配置模板
# 复制为 .env 文件并按需修改

### 运行模式
GAOKAO_ENV=dev              # dev | prod（prod 启用安全强制检查）

### 数据库
GAOKAO_DB=sqlite            # sqlite | postgresql
DATABASE_URL=postgresql://gaokao:gaokao@localhost:5432/gaokao  # GAOKAO_DB=postgresql 时使用

### 安全凭证（生产环境【必须】设置）
JWT_SECRET=                 # 留空则 dev 模式自动生成临时密钥
API_KEY=                    # 留空则 dev 模式允许本地无鉴权
JWT_REFRESH_SECRET=         # 可选，默认复用 JWT_SECRET
TOKEN_BLACKLIST_ENABLED=true
WEBHOOK_SECRET=             # Webhook HMAC 签名密钥

### 跨域
CORS_ORIGINS=http://localhost:8000  # 逗号分隔白名单

### Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

### Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=gaokao-analyzer-master-key

### IRT 引擎
IRT_PREHEAT=true            # 启动时预热 IRT 参数缓存

### 数据库连接池
PG_POOL_MIN_SIZE=2
PG_POOL_MAX_SIZE=10
