sequenceDiagram
    participant U as 用户
    participant React as React App
    participant AuthCtx as AuthContext
    participant Axios as Axios (API Client)
    participant FastAPI as FastAPI Backend

    %% ===== Authentication Flow =====
    rect rgb(240, 248, 255)
        Note over U,FastAPI: 认证流程 (Login)
        U->>React: 输入用户名/密码并登录
        React->>AuthCtx: login(username, password)
        AuthCtx->>Axios: POST /api/v1/auth/login
        Axios->>FastAPI: POST /api/v1/auth/login
        FastAPI-->>Axios: { token, user }
        Axios-->>AuthCtx: 响应数据
        AuthCtx->>AuthCtx: 存储 token (localStorage)
        AuthCtx->>AuthCtx: 设置 axios 默认 Authorization header
        AuthCtx-->>React: 登录成功
        React-->>U: 跳转至仪表盘
    end

    %% ===== Dashboard Flow =====
    rect rgb(255, 248, 240)
        Note over U,FastAPI: 仪表盘加载
        U->>React: 导航至仪表盘
        React->>React: DashboardPage 挂载
        React->>Axios: GET /api/v1/dashboard
        Axios->>FastAPI: GET /api/v1/dashboard
        FastAPI-->>Axios: { total_papers, verified_count, ... }
        Axios-->>React: 仪表盘数据
        React-->>U: 渲染统计卡片 + 最新试卷列表
    end

    %% ===== Paper List with Filters =====
    rect rgb(245, 245, 255)
        Note over U,FastAPI: 试卷列表 + 筛选
        U->>React: 进入试卷库页面
        React->>React: PaperListPage 挂载
        React->>Axios: GET /api/v1/filters (初始化)
        Axios->>FastAPI: GET /api/v1/filters
        FastAPI-->>Axios: { subjects, paper_types, years, provinces, exam_tags }
        Axios-->>React: 筛选条件
        React->>Axios: GET /api/v1/search?page=1&size=20
        Axios->>FastAPI: GET /api/v1/search?page=1&size=20
        FastAPI-->>Axios: { data: Paper[], total: number }
        Axios-->>React: 试卷列表 + 总数
        React-->>U: 渲染试卷卡片 + 分页 + 筛选栏

        U->>React: 选择筛选条件 (例如科目=数学)
        React->>Axios: GET /api/v1/search?subject=math&page=1&size=20
        Axios->>FastAPI: GET /api/v1/search?subject=math
        FastAPI-->>Axios: 筛选结果
        Axios-->>React: 更新列表
        React-->>U: 重新渲染试卷卡片列表
    end

    %% ===== Global Search =====
    rect rgb(240, 255, 240)
        Note over U,FastAPI: 全局搜索 + 联想
        U->>React: 在导航栏输入搜索词
        React->>React: debounce 300ms
        React->>Axios: GET /api/v1/search/suggest?q=...
        Axios->>FastAPI: GET /api/v1/search/suggest?q=...
        FastAPI-->>Axios: { suggestions: string[] }
        Axios-->>React: 联想建议列表
        React-->>U: 显示下拉建议

        U->>React: 按 Enter 或选择建议
        React->>Axios: GET /api/v1/search?q=...&page=1&size=20
        Axios->>FastAPI: GET /api/v1/search?q=...
        FastAPI-->>Axios: 搜索结果
        Axios-->>React: 搜索结果列表
        React-->>U: 跳转到试卷列表页并显示结果
    end

    %% ===== Paper Detail + Operations =====
    rect rgb(255, 240, 245)
        Note over U,FastAPI: 试卷详情与操作
        U->>React: 点击试卷卡片
        React->>React: PaperDetailPage 挂载, paperId
        React->>Axios: GET /api/v1/papers/{id}
        Axios->>FastAPI: GET /api/v1/papers/{id}
        FastAPI-->>Axios: { paper, questions, analyses, region_check, source }
        Axios-->>React: 完整试卷数据
        React-->>U: 渲染试卷详情 + 题目列表 + 已有分析

        U->>React: 点击 "IRT 分析"
        React->>Axios: POST /api/v1/papers/{id}/estimate-irt
        Axios->>FastAPI: POST /api/v1/papers/{id}/estimate-irt
        FastAPI-->>Axios: { estimated: number }
        Axios-->>React: 分析完成
        React->>Axios: GET /api/v1/papers/{id} (刷新)
        Axios-->>React: 更新后的试卷数据
        React-->>U: 显示 IRT 分析结果

        U->>React: 点击 "质量分析报告"
        React->>Axios: POST /api/v1/papers/{id}/analyze
        Axios->>FastAPI: POST /api/v1/papers/{id}/analyze
        FastAPI-->>Axios: AnalysisReport
        Axios-->>React: 报告数据
        React->>React: 渲染 ECharts 图表 (雷达/柱状/折线)
        React-->>U: 显示质量分析报告
    end

    %% ===== Collect Flow =====
    rect rgb(245, 255, 250)
        Note over U,FastAPI: 试卷采集
        U->>React: 填写采集表单并点击开始采集
        React->>Axios: POST /api/v1/scrape/collect?year=2026&keyword=深圳二模
        Axios->>FastAPI: POST /api/v1/scrape/collect
        FastAPI-->>Axios: { found, saved, skipped_duplicates }
        Axios-->>React: 采集结果
        React-->>U: 显示采集完成 Toast

        React->>Axios: GET /api/v1/scrape/status
        Axios->>FastAPI: GET /api/v1/scrape/status
        FastAPI-->>Axios: { total_papers, dedup_stats, auto_scraper_status, recent_logs }
        Axios-->>React: 采集状态
        React-->>U: 更新采集统计和日志
    end

    %% ===== Audit Flow =====
    rect rgb(255, 245, 255)
        Note over U,FastAPI: 真实性审核
        U->>React: 导航至审核页
        React->>Axios: GET /api/v1/audit/summary
        Axios->>FastAPI: GET /api/v1/audit/summary
        FastAPI-->>Axios: { total_papers, verified_papers, unverified_papers }
        Axios-->>React: 审核统计
        React-->>U: 显示审核统计卡片

        U->>React: 点击 "批量审核"
        React->>Axios: POST /api/v1/audit/batch?limit=50
        Axios->>FastAPI: POST /api/v1/audit/batch
        FastAPI-->>Axios: { total_audited, grade_distribution }
        Axios-->>React: 批量审核结果
        React-->>U: 显示审核结果
    end

    %% ===== Error Handling =====
    rect rgb(255, 235, 235)
        Note over U,FastAPI: 统一错误处理
        U->>React: 触发 API 请求
        React->>Axios: 任意 API 请求
        Axios-->>React: HTTP 401 (token 过期)
        React->>React: Axios 拦截器捕获 401
        React->>AuthCtx: logout()
        AuthCtx-->>React: 清除 token
        React-->>U: 跳转至登录页

        Note over React,Axios: Axios 响应拦截器
        React->>Axios: 任意 API 请求
        Axios-->>React: HTTP 4xx/5xx
        React->>React: 解析错误信息
        React-->>U: 显示 Toast 错误提示
    end
