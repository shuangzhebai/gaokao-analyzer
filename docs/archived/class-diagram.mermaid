classDiagram
    %% ===== Core Types =====
    class Paper {
        +number id
        +string title
        +string subject
        +string paper_type
        +number year
        +string province
        +string exam_tag
        +string school
        +number total_score
        +number difficulty
        +string analysis_status
        +boolean verified
        +number question_count
        +string source_name
        +string source_priority
        +string snippet
    }

    class Question {
        +number id
        +number paper_id
        +number q_number
        +string q_type
        +number score
        +string content
        +string answer
        +string knowledge_points
        +string quality_rating
        +boolean is_quality
        +number difficulty_param
        +number discrimination_param
        +number guess_param
    }

    class Analysis {
        +number id
        +number paper_id
        +string analysis_type
        +string status
        +json simulation_json
        +json quality_metrics
        +datetime created_at
    }

    class AuditResult {
        +number paper_id
        +string grade
        +number score
        +string detail
    }

    class OfficialDoc {
        +number id
        +string title
        +string category
        +string source
        +number year
        +string priority
        +string summary
        +string source_url
    }

    class Subject {
        +string id
        +string name
    }

    class DashboardStats {
        +number total_papers
        +number verified_count
        +number real_count
        +number analyzed_papers
        +number quality_questions
        +number official_docs_count
        +Paper[] latest_papers
    }

    class FilterOptions {
        +Subject[] subjects
        +object paper_types
        +number[] years
        +string[] provinces
        +string[] exam_tags
    }

    class CollectStatus {
        +number total_papers
        +object dedup_stats
        +object auto_scraper_status
        +LogEntry[] recent_logs
    }

    class AnalysisReport {
        +object composite
        +object dimensions
        +object visualization
    }

    %% ===== Contexts =====
    class AuthContextType {
        +User|null user
        +string|null token
        +boolean isLoading
        +boolean isAuthenticated
        +function login(username, password)
        +function register(username, password, email, role)
        +function logout()
    }

    class I18nContextType {
        +string locale
        +function t(key, params)
        +function setLocale(locale)
        +object messages
    }

    %% ===== Services =====
    class ApiClient {
        +AxiosInstance instance
        +interceptors request
        +interceptors response
    }

    class AuthService {
        +function login(username, password)
        +function register(username, password, email, role)
        +function getMe()
    }

    class PaperService {
        +function list(params)
        +function getById(id)
        +function delete(id)
        +function upload(file, metadata)
        +function estimateIRT(id, nSimStudents)
        +function simulate(id, nStudents)
        +function curriculumAnalysis(id)
        +function qualityAnalysis(id)
        +function analyze(id)
        +function getReport(id)
    }

    class CollectService {
        +function start(params)
        +function getStatus()
    }

    class DocService {
        +function list(params)
        +function refresh()
        +function getCategories()
    }

    class AuditService {
        +function getSummary()
        +function batchAudit(limit)
        +function auditPaper(id)
    }

    class DashboardService {
        +function getStats()
    }

    class SearchService {
        +function search(params)
        +function suggest(q)
    }

    class FilterService {
        +function getFilters()
    }

    %% ===== Pages =====
    class DashboardPage {
        +function loadStats()
        +function loadLatestPapers()
    }

    class PaperListPage {
        +function searchPapers()
        +function clearFilters()
        +function onPageChange()
    }

    class PaperDetailPage {
        +function loadDetail(id)
        +function onIRT()
        +function onSimulate()
        +function onCurriculum()
        +function onQuality()
        +function onAnalyze()
        +function onAudit()
        +function onDelete()
    }

    class CollectPage {
        +function startCollect(params)
        +function loadStatus()
    }

    class DocsPage {
        +function loadDocs(params)
        +function refresh()
    }

    class AuditPage {
        +function loadSummary()
        +function runBatchAudit()
    }

    class LoginPage {
        +function handleLogin()
    }

    class RegisterPage {
        +function handleRegister()
    }

    %% ===== Components =====
    class Navbar {
        +string searchQuery
        +function onSearch()
        +function onSuggestionSelect()
    }

    class Sidebar {
        +function onNavigate()
        +string activePage
    }

    class BottomNav {
        +function onNavigate()
        +string activePage
    }

    class FilterBar {
        +object filters
        +function onChange()
        +function onClear()
    }

    class PaperCard {
        +Paper paper
        +function onClick()
    }

    class StatCard {
        +string icon
        +number value
        +string label
        +string color
    }

    class Pagination {
        +number total
        +number page
        +number pageSize
        +function onPageChange()
    }

    class QuestionCard {
        +Question question
    }

    class AnalysisReportView {
        +AnalysisReport report
    }

    class ChartView {
        +string chartType
        +object option
        +function destroy()
    }

    class LoadingState {
        +string message
    }

    class EmptyState {
        +string icon
        +string text
        +string hint
    }

    class ErrorState {
        +string message
        +function onRetry()
    }

    class ConfirmDialog {
        +string title
        +string message
        +function onConfirm()
        +function onCancel()
    }

    class Toast {
        +string message
        +string type
        +number duration
    }

    %% ===== Relationships =====
    AuthContextType --> AuthService : uses
    I18nContextType ..> object : messages

    DashboardPage --> DashboardService : calls
    DashboardPage --> StatCard : renders
    DashboardPage --> PaperCard : renders

    PaperListPage --> FilterBar : contains
    PaperListPage --> PaperCard : renders
    PaperListPage --> Pagination : contains
    PaperListPage --> SearchService : calls
    PaperListPage --> FilterService : calls

    PaperDetailPage --> QuestionCard : renders
    PaperDetailPage --> ChartView : renders
    PaperDetailPage --> AnalysisReportView : renders
    PaperDetailPage --> PaperService : calls
    PaperDetailPage --> AuditService : calls

    CollectPage --> CollectService : calls
    DocsPage --> DocService : calls
    AuditPage --> AuditService : calls

    Navbar --> SearchService : calls
    Navbar --> BottomNav : mobile

    ApiClient --> AuthContextType : reads token
